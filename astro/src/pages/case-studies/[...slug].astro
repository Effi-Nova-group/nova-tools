---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const d = study.data;

// No campaign screenshot? Fall back to the client logo in the hero slot.
const hero = d.heroImage ?? d.logo;
const heroAlt = d.heroImage ? `${d.client} campaign work` : `${d.client} logo`;
const published = d.publishedAt.toISOString().slice(0, 10);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.metaDescription,
  about: { '@type': 'Organization', name: d.client },
  articleSection: d.sector,
  datePublished: published,
  dateModified: published,
  author: { '@type': 'Organization', name: 'Nova Tools' },
  publisher: { '@type': 'Organization', name: 'Nova Tools' },
};
---
<BaseLayout
  title={d.metaTitle}
  description={d.metaDescription}
  ogType="article"
  bodyClass="blog-body"
  wrapMain={false}
  jsonLd={jsonLd}
>
  <article class="cs-article">
    <div class="cs-detail-head">
      <a href="/case-studies/" class="cs-back">Back to all case studies</a>

      <span class="cs-eyebrow">{d.sector}</span>
      <h1 class="cs-detail__title">{d.title}</h1>
      <p class="cs-detail__subtitle">{d.subtitle}</p>

      {d.logo && (
        <div class="cs-detail__logo">
          <Image src={d.logo} alt={`${d.client} logo`} loading="eager" />
        </div>
      )}

      {d.stats.length > 0 && (
        <ul class="cs-metrics" role="list">
          {d.stats.map((stat) => (
            <li class="cs-metric">
              <span class="cs-metric__value">{stat.value}</span>
              <span class="cs-metric__label">{stat.label}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="cs-detail__hero">
      {hero ? (
        <Image src={hero} alt={heroAlt} loading="lazy" />
      ) : (
        <div class="cs-fallback cs-fallback--hero"><span>{d.client}</span></div>
      )}
    </div>

    <div class="post-body cs-body">
      <Content />
    </div>

    <aside class="cs-cta">
      <h2 class="cs-cta__heading">{d.ctaHeading}</h2>
      <p class="cs-cta__body">{d.ctaBody}</p>
      <div class="button-primary-gradient">
        <a href="/#contact" class="button-primary small-v2 w-button">Get started</a>
      </div>
    </aside>

    <div class="post-back cs-detail-foot">
      <a href="/case-studies/">Back to all case studies</a>
    </div>
  </article>
</BaseLayout>
