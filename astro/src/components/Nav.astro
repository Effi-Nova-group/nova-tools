---
// Full Webflow nav — mirrors the homepage <div class="header w-nav"> exactly.
// Absolute paths ("/index.html" style) work uniformly on homepage + subpages.
const base = '/';
---
<div
  data-animation="over-left"
  class="header w-nav"
  data-easing2="ease"
  data-easing="ease"
  data-collapse="medium"
  data-w-id="5ad941c8-f990-62a8-38a0-3b54006c05b3"
  role="banner"
  data-duration="400"
>
  <div class="container-default w-container">
    <div class="header-wrapper">
      <div class="split-content header-right">
        <a href={base} class="brand w-nav-brand">
          <img src="/images/Screenshot-2026-07-24-at-10.31.30-am-1.png" alt="Nova Tools" class="header-logo" />
        </a>
      </div>
      <div class="split-content header-center">
        <nav role="navigation" data-w-id="5ad941c8-f990-62a8-38a0-3b54006c05ba" class="nav-menu w-nav-menu">
          <ul role="list" class="header-navigation none w-list-unstyled">
            <li class="nav-item-wrapper"><a href={base} class="nav-link">Home</a></li>
            <li class="nav-item-wrapper"><a href={`${base}#about`} class="nav-link">About</a></li>
            <li class="nav-item-wrapper"><a href={`${base}#pricing`} class="nav-link">Pricing</a></li>
            <li class="nav-item-wrapper">
              <div data-hover="true" data-delay="0" data-w-id="5ad941c8-f990-62a8-38a0-3b54006c05c6" class="nav-link-dropdown w-dropdown">
                <div class="nav-link dropdown w-dropdown-toggle">
                  <div>Pages  <span class="dropdown-arrow"></span></div>
                </div>
                <nav data-w-id="5ad941c8-f990-62a8-38a0-3b54006c05cc" class="dropdown-list w-dropdown-list">
                  <div class="dropdown-nav-main-wrapper">
                    <div class="dropdown-nav-pages-wrapper">
                      <div class="title dropdown">Menu</div>
                      <div class="dropdown-nav-content">
                        <ul role="list" class="dropdown-nav">
                          <li class="dropdown-nav-item"><a href={base} class="dropdown-nav-link">Home</a></li>
                          <li class="dropdown-nav-item"><a href={`${base}#about`} class="dropdown-nav-link">About</a></li>
                          <li class="dropdown-nav-item"><a href={`${base}#contact`} class="dropdown-nav-link">Contact</a></li>
                          <li class="dropdown-nav-item"><a href="/blogs/" class="dropdown-nav-link">Blog</a></li>
                          <li class="dropdown-nav-item"><a href={`${base}#pricing`} class="dropdown-nav-link">Pricing</a></li>
                        </ul>
                        <ul role="list" class="dropdown-nav last">
                          <li class="dropdown-nav-item"><a href="#" class="dropdown-nav-link">Integrations</a></li>
                          <li class="dropdown-nav-item"><a href="#" class="dropdown-nav-link">Careers</a></li>
                          <li class="dropdown-nav-item"><a href="#" class="dropdown-nav-link">Features</a></li>
                          <li class="dropdown-nav-item"><a href="#" class="dropdown-nav-link">Team</a></li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </nav>
              </div>
            </li>
            <li class="nav-item-wrapper mobile"><a href="#" class="nav-link sign-in mobile">Sign in</a></li>
            <li class="nav-item-wrapper mobile-button">
              <div class="button-primary-gradient header-button mobile-button">
                <a href={`${base}#contact`} class="button-primary small-v2 mobile-button w-button">Get started</a>
              </div>
            </li>
          </ul>
        </nav>
      </div>
      <div class="split-content header-left">
        <a href="#" class="nav-link sign-in none">Sign in</a>
        <div class="button-primary-gradient header-button">
          <a href={`${base}#contact`} class="button-primary small-v2 w-button">Get started</a>
        </div>
        <div class="menu-button w-nav-button">
          <div class="header-menu-button-icon-wrapper">
            <div class="icon-wrapper">
              <div class="header-menu-button-icon-top"></div>
              <div class="header-menu-button-icon-medium"></div>
              <div class="header-menu-button-icon-bottom"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
