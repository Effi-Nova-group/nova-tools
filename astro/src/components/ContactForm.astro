---
---
<form id="contactForm" class="contact-form">
  <input type="hidden" name="access_key" value="2d5a3158-c709-4f2d-b6ec-1497c02eebcf" />
  <div class="contact-form__row">
    <div class="contact-form__field">
      <label for="cf-first-name">First Name<span class="contact-form__required">*</span></label>
      <input id="cf-first-name" type="text" name="first_name" autocomplete="given-name" required />
    </div>
    <div class="contact-form__field">
      <label for="cf-last-name">Last Name<span class="contact-form__required">*</span></label>
      <input id="cf-last-name" type="text" name="last_name" autocomplete="family-name" required />
    </div>
  </div>
  <div class="contact-form__field">
    <label for="cf-email">Business Email<span class="contact-form__required">*</span></label>
    <input id="cf-email" type="email" name="business_email" autocomplete="email" required />
  </div>
  <div class="contact-form__row">
    <div class="contact-form__field">
      <label for="cf-company">Company Name<span class="contact-form__required">*</span></label>
      <input id="cf-company" type="text" name="company_name" autocomplete="organization" required />
    </div>
    <div class="contact-form__field">
      <label for="cf-phone">Phone Number<span class="contact-form__required">*</span></label>
      <input id="cf-phone" type="tel" name="phone_number" autocomplete="tel" required />
    </div>
  </div>
  <div class="contact-form__submit-wrap">
    <div class="button-primary-gradient header-button">
      <button type="submit" class="button-primary small-v2 w-button">Book a Strategy Call</button>
    </div>
  </div>
  <div id="cf-result" class="contact-form__result" aria-live="polite"></div>
</form>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const result = document.getElementById('cf-result');
  if (form && result) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      result.textContent = 'Sending...';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await res.json();
        if (data.success) {
          result.textContent = 'Form submitted successfully';
          form.reset();
        } else {
          result.textContent = data.message || 'Something went wrong.';
        }
      } catch (err) {
        result.textContent = 'Network error. Please try again.';
      }
    });
  }
</script>
